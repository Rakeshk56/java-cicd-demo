
pipeline {
    agent any

    triggers {
        pollSCM('H/2 * * * *')
    }

    stages {
        stage('Build and Test with Maven') {
            steps {
                sh '''
                    docker run --rm \
                      -v "$WORKSPACE:/app" \
                      -w /app \
                      maven:3.9-eclipse-temurin-21 \
                      mvn -B clean package
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                      -t java-cicd-demo:${BUILD_NUMBER} ./java-cicd-demo
                '''
            }
        }

        stage('Deploy on Local Docker') {
            steps {
                sh '''
                    docker rm -f java-cicd-demo || true

                    docker run -d \
                      --name java-cicd-demo \
                      --restart unless-stopped \
                      -p 8081:8080 \
                      java-cicd-demo:${BUILD_NUMBER}
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    docker ps --filter name=java-cicd-demo
                    docker logs --tail 30 java-cicd-demo
                '''
            }
        }
    }
}
